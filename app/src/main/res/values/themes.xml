<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ListaSpam" parent="Theme.MaterialComponents.DayNight">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryVariant">@color/white</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/black</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.ListaSpam.MaterialAlertDialog</item>
    </style>

    <!-- colorPrimary is white in the light theme, which made the dialog buttons invisible -->
    <style name="ThemeOverlay.ListaSpam.MaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/black</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>

    <style name="Theme.ListaSpam" parent="Base.Theme.ListaSpam" />
</resources>